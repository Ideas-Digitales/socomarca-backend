{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy: Development",
      "detail": "Start containers, run migrations and seeders (no image build, no cache warm-up)",
      "type": "shell",
      "command": "./scripts/deploy-dev.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy: Development (fresh database)",
      "detail": "Same as 'Deploy: Development' but drops every table first — DESTROYS local data",
      "type": "shell",
      "command": "./scripts/deploy-dev.sh --fresh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy: Development (custom options)",
      "detail": "Run the development deploy script with the options you type (e.g. --no-seed)",
      "type": "shell",
      "command": "./scripts/deploy-dev.sh ${input:deployOptions}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy: Run seeder",
      "detail": "Run a single seeder class inside the app container",
      "type": "shell",
      "command": "./scripts/deploy-dev.sh --skip-health --seeder=${input:seederClass}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Start compose",
      "type": "shell",
      "command": "docker compose up -d",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Stop compose",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Destroy compose",
      "type": "shell",
      "command": "docker compose down -v --rmi all --remove-orphans",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Run container",
      "type": "shell",
      "command": "docker compose run --rm -it ${input:service} /usr/bin/bash",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Run laravel command",
      "type": "shell",
      "command": "docker compose run --rm -it app php artisan ${input:laravelCommand}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Create testing database",
      "type": "shell",
      "command": "docker compose exec db psql --username=socomarca_user -c \"CREATE DATABASE socomarca_backend_testing;\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Run migrations testing",
      "type": "shell",
      "command": "docker compose exec app php artisan migrate --env=testing",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Prettier: Format Current File",
      "type": "shell",
      "command": "npm run prettier -- ${relativeFile} --write",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "laravelCommand",
      "type": "promptString",
      "description": "Command to execute inside the app container (e.g. php artisan test)",
      "default": ""
    },
    {
      "id": "service",
      "type": "promptString",
      "description": "Service to run the command in (e.g. app)",
      "default": "app"
    },
    {
      "id": "deployOptions",
      "type": "pickString",
      "description": "Options for scripts/deploy-dev.sh",
      "options": [
        "",
        "--fresh",
        "--no-seed",
        "--clear-cache",
        "--dry-run",
        "--skip-health"
      ],
      "default": ""
    },
    {
      "id": "seederClass",
      "type": "promptString",
      "description": "Seeder class to run (e.g. RolesAndPermissionsSeeder)",
      "default": "RolesAndPermissionsSeeder"
    }
  ]
}
